  "main": "index.js",
  "scripts": {
    "setup": "npm install && npx playwright install",
    "test": "playwright test",
    "test:all": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:web": "playwright test src/tests/web",
    "test:api": "playwright test src/tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "test:positive": "playwright test --grep @positive",
    "report": "playwright show-report reports/playwright-report",
    "report:open": "open reports/playwright-report/index.html",
    "report:json": "cat reports/test-results.json",
    "clean": "rm -rf reports/playwright-report reports/screenshots reports/videos reports/test-results.json reports/junit.xml playwright-report",
    "clean:all": "rm -rf reports playwright-report node_modules"
  },
